{
  "name": "augengine-detective-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Gate 4: The Wrenfield Observatory — a small, finished detective game on AugEngine. Suspects are personas with per-player memory and guardrailed LLM dialogue; every fact comes from the rule engine.",
  "scripts": {
    "dev": "vite --port 5193",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5194",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test --config playwright.config.ts",
    "adversarial": "node --experimental-strip-types scripts/adversarial.ts",
    "test": "vitest run server src"
  },
  "dependencies": {
    "@mnemopay/augengine": "*",
    "@mnemopay/augengine-detective": "*"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^20.0.0",
    "@webgpu/types": "^0.1.69",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vitest": "^1.5.0"
  }
}
